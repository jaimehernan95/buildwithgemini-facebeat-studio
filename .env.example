# Google Gemini API Key for Antigravity Agents
GEMINI_API_KEY=

# Spotify Developer API Credentials (Optional - for Spotify track sync)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Output & Storage Directories
MEDIA_DIR=app/static/media
OUTPUT_CLIPS_DIR=app/static/media/clips
AUDIO_DIR=app/static/audio
